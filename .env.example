# Cloudflare R2 Configuration
# Copy file này thành .env và điền thông tin của bạn
# File .env đã được thêm vào .gitignore để không bị commit

# Lấy từ Cloudflare Dashboard (góc phải màn hình)
CF_ACCOUNT_ID=your_cloudflare_account_id_here

# Lấy từ R2 → Manage R2 API Tokens → Create API Token
# Format: access_key_id:secret_access_key
CF_API_TOKEN=access_key_id:secret_access_key_here

# Tên bucket R2 (bạn tạo trên dashboard)
CF_R2_BUCKET=c69-releases

# Public URL của bucket (bật Public Access trong Settings → copy URL)
# Dạng: https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev
CF_R2_PUBLIC_URL=https://pub-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.r2.dev
