+#include "base/command_line.h"
 
 namespace blink {
 
@@ -3500,6 +3501,19 @@ ScriptValue WebGLRenderingContextBase::getParameter(ScriptState* script_state,
       return ScriptValue::CreateNull(script_state->GetIsolate());
     case GL_VENDOR:
+      {
+        const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+        if (cmd.HasSwitch("qhtd-webgl-vendor")) {
+          return WebGLAny(script_state, String(cmd.GetSwitchValueASCII("qhtd-webgl-vendor").c_str()));
