       return WebGLAny(script_state, String("WebKit WebGL"));
     case GL_UNMASKED_VENDOR_WEBGL:
+      {
+        const base::CommandLine& cmd = *base::CommandLine::ForCurrentProcess();
+        if (cmd.HasSwitch("qhtd-webgl-vendor")) {
+          return WebGLAny(script_state, String(cmd.GetSwitchValueASCII("qhtd-webgl-vendor").c_str()));
